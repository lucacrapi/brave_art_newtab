{
  "manifest_version": 3,
  "name": "Brave Wallpaper New Tab",
  "version": "0.1.0",
  "description": "Remplace le nouvel onglet par une page simple avec fond personnalisable.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "search"],
  "host_permissions": ["https://commons.wikimedia.org/*", "https://query.wikidata.org/*"],
  "action": {
    "default_title": "Brave Wallpaper New Tab"
  }
}
